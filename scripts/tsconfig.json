{
  "//": "SPDX-License-Identifier: AGPL-3.0-or-later — typecheck for root dev scripts (run in plain Node via tsx). Node globals only; no DOM.",
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true
  },
  "include": ["**/*.ts"]
}
